                            }

                            #Increment Offset
                            $nSrchRlstOffset += $nSrchRsltLimit;

                            #Check Offset to Total Count
                            if($nSrchRlstOffset -ge $nTotalCnt)
                            {
                                $bRetrMoreSrchRslts = $false;
                            }

                        }
                        else
                        {
                            $bRetrMoreSrchRslts = $false;
